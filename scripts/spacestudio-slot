#!/bin/sh
# Render semaphore wrapper (works in Linux shells and in Git Bash on Windows).
# SpaceStudio sets SPACESTUDIO_PYTHON to its own interpreter for every Claude run.
here=$(cd "$(dirname "$0")" && pwd)
py=${SPACESTUDIO_PYTHON:-}
if [ -z "$py" ]; then
  for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys" >/dev/null 2>&1; then py=$c; break; fi
  done
fi
[ -n "$py" ] || { echo "spacestudio-slot: no Python found (set SPACESTUDIO_PYTHON)" >&2; exit 127; }
exec "$py" "$here/spacestudio_slot.py" "$@"
